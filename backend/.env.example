# Copy these names into your hosting provider's application environment settings.
# Never commit a real .env file or replace the placeholders below in this file.

NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_INITIAL_EMAIL=admin@your-domain.example
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
FRONTEND_URL=https://your-domain.example